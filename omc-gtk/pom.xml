<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.omc</groupId>
        <artifactId>omc</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>omc-gtk</artifactId>
    <packaging>jar</packaging>
    <name>omc-gtk</name>
    <description>The GTK UI of the Open Media Converter</description>

    <properties>
        <omc.skipEmbeddedTools>false</omc.skipEmbeddedTools>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.omc</groupId>
            <artifactId>omc-core</artifactId>
            <version>${project.version}</version>
            <type>jar</type>
        </dependency>

        <!-- GTK 4 bindings via java-gi (version managed by parent) -->
        <dependency>
            <groupId>io.github.jwharm.javagi</groupId>
            <artifactId>gtk</artifactId>
        </dependency>

        <!-- Directly imported by omc-gtk sources (org.slf4j.Logger and
             ch.qos.logback.classic for debug root-logger switching in
             MainApplicationJavaGi); versions managed by parent -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- Testing dependencies (versions managed by parent) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
             <!-- Maven Compiler Plugin for Java 23 (release/source/target
                  are inherited from the parent properties) -->
              <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-compiler-plugin</artifactId>
                  <version>3.13.0</version>
                   <configuration>
                       <showWarnings>true</showWarnings>
                       <showDeprecation>true</showDeprecation>
                   </configuration>
              </plugin>

            <!-- Maven Surefire Plugin for running tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>

            <!-- Maven Assembly Plugin for creating fat JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>org.omc.ui.MainApplicationJavaGi</mainClass>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                        <manifestEntries>
                            <Built-By>Open Media Converter Team</Built-By>
                            <Build-Time>${maven.build.timestamp}</Build-Time>
                            <Application-Name>Open Media Converter</Application-Name>
                            <Application-Version>${project.version}</Application-Version>
                        </manifestEntries>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <finalName>open-media-converter-${project.version}</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven Resources Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Maven Exec Plugin for running the application -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.2</version>
                <configuration>
                    <mainClass>org.omc.ui.MainApplicationJavaGi</mainClass>
                </configuration>
                <executions>
                    <!-- Run packaging scripts during deploy phase -->
                    <execution>
                        <id>prepare-embedded-tools</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>${omc.skipEmbeddedTools}</skip>
                            <executable>python3</executable>
                            <arguments>
                                <argument>${project.basedir}/scripts/prepare-tools.py</argument>
                                <argument>--offline=${settings.offline}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Distribution packages (DEB/RPM/Arch/AppImage) are NOT
                         built during a normal `mvn deploy`: the packaging
                         toolchain is host-specific and often unavailable.
                         Activate explicitly with -Prelease-packages. -->
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <!-- Opt-in packaging runs: mvn deploy -Prelease-packages -->
            <id>release-packages</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-packages</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>scripts/build-packages.sh</argument>
                                        <argument>--all</argument>
                                        <argument>--skip-build</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>embedded-tools</id>
            <activation>
                <property><name>omc.skipEmbeddedTools</name><value>!true</value></property>
            </activation>
            <build>
                <resources>
                    <resource><directory>src/main/resources</directory></resource>
                    <resource><directory>.tool-cache/resources</directory></resource>
                </resources>
            </build>
        </profile>
    </profiles>
</project>
