<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Property for log directory - defaults to ~/.local/share/open-media-converter/logs/ -->
    <property name="LOG_DIR" value="${user.home}/.local/share/open-media-converter/logs" />
    
    <!-- Property for log pattern -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n" />
    
    <!-- Console Appender - INFO level for general output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>
    
    <!-- Main Application Log - DEBUG level with rotation -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Daily rollover -->
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- Max 100MB per file -->
            <maxFileSize>100MB</maxFileSize>
            <!-- Keep 10 files -->
            <maxHistory>10</maxHistory>
            <!-- Total size cap of 1GB -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
    </appender>
    
    <!-- Conversion Operations Log - tracks all conversion activities -->
    <appender name="CONVERSION_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/conversion.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/conversion.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>10</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
    </appender>
    
    <!-- Error Log - ERROR level only -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/error.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>10</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>
    
    <!-- Logger for conversion operations -->
    <logger name="org.omc.core.ConversionEngine" level="DEBUG" additivity="false">
        <appender-ref ref="CONVERSION_FILE" />
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>
    
    <logger name="org.omc.service" level="DEBUG" additivity="false">
        <appender-ref ref="CONVERSION_FILE" />
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>
    
    <!-- Logger for tool execution -->
    <logger name="org.omc.core.ToolManager" level="DEBUG" additivity="false">
        <appender-ref ref="CONVERSION_FILE" />
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>
    
    <!-- Root logger - catches everything else -->
    <root level="DEBUG">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="APP_FILE" />
        <appender-ref ref="ERROR_FILE" />
    </root>
</configuration>
