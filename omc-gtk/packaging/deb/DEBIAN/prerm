#!/bin/bash
# prerm script for open-media-converter
# Pre-removal script for Open Media Converter

set -e

# Summary of what this script does:
#  - Checks for running instances and warns user
#  - Provides option to stop running instances (if needed)
#  - Cleans up temporary files
#  - Prepares for package removal

case "$1" in
    remove|upgrade|deconfigure)
        echo "Preparing to remove Open Media Converter..."

        # Check if application is running
        if pgrep -f "open-media-converter.*jar" >/dev/null 2>&1; then
            echo "WARNING: Open Media Converter is currently running."
            echo "Please close all instances before uninstalling."
            echo ""
            echo "Running instances detected. The application will be removed,"
            echo "but you should close running instances to avoid issues."
            echo ""
            # Note: We don't forcibly kill the process - let user decide
        fi

        # Clean up any temporary files in system-wide temp directory
        # User-specific config and data will remain in home directories
        if [ -d /tmp/open-media-converter-* ]; then
            echo "Cleaning up temporary files..."
            rm -rf /tmp/open-media-converter-* 2>/dev/null || true
        fi

        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
