#!/bin/bash
# Resolve paths on each launch; AppImages and extracted AppDirs can move.
# Native RUNPATHs keep the private GTK libraries out of host conversion tools.
set -euo pipefail
APPDIR="$(dirname "$(readlink -f "$0")")"
APP_HOME="$APPDIR/opt/open-media-converter"
export OMC_APP_DIR="$APPDIR"
export PATH="$APPDIR/usr/bin:$PATH"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GTK_THEME="${GTK_THEME:-Adwaita}"

# Loader caches contain absolute filenames, so generate one outside the
# read-only AppDir for this mount point and remove it when the app exits.
cache_dir=$(mktemp -d "${TMPDIR:-/tmp}/omc-appimage.XXXXXXXX")
app_pid=
cleanup() {
    if [ -n "$app_pid" ]; then
        kill "$app_pid" 2>/dev/null || true
        wait "$app_pid" 2>/dev/null || true
    fi
    rm -rf "$cache_dir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
export GDK_PIXBUF_MODULEDIR="$APPDIR/usr/lib/omc/gdk-pixbuf-loaders"
export GDK_PIXBUF_MODULE_FILE="$cache_dir/loaders.cache"
"$APPDIR/usr/libexec/gdk-pixbuf-query-loaders" > "$GDK_PIXBUF_MODULE_FILE"

JVM_OPTS=(-Xmx2G -Xms512M -XX:+UseG1GC -XX:MaxGCPauseMillis=200
    -Dsun.java2d.opengl=true -Djava.awt.headless=false)
if [ -n "${OMC_JVM_OPTS:-}" ]; then
    read -r -a JVM_OPTS <<< "$OMC_JVM_OPTS"
fi
if [ -z "${GDK_BACKEND:-}" ]; then
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        export GDK_BACKEND=wayland,x11
    elif [ -n "${DISPLAY:-}" ]; then
        export GDK_BACKEND=x11
    fi
fi

"$APP_HOME/runtime/bin/java" "${JVM_OPTS[@]}" --enable-native-access=ALL-UNNAMED \
    "-Djavagi.path=$APPDIR/usr/lib/omc" "-Djava.library.path=$APPDIR/usr/lib/omc" \
    -Domc.appimage=true "-Domc.appdir=$APPDIR" -jar "$APP_HOME/omc.jar" "$@" &
app_pid=$!
status=0
wait "$app_pid" || status=$?
app_pid=
exit "$status"
