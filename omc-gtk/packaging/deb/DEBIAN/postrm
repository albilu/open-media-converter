#!/bin/bash
# postrm script for open-media-converter
# Post-removal script for Open Media Converter

set -e

# Summary of what this script does:
#  - Updates desktop database after removal
#  - Updates MIME database after removal
#  - Updates icon cache after removal
#  - Optionally purges user configuration (on purge)
#  - Prints post-removal messages

case "$1" in
    remove|purge|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        
        if [ "$1" = "purge" ]; then
            echo "Purging Open Media Converter configuration..."
            
            # Note: We don't automatically delete user data from home directories
            # Users should manually delete ~/.config/open-media-converter/ and
            # ~/.local/share/open-media-converter/ if desired
            
            echo ""
            echo "========================================"
            echo "Open Media Converter has been purged."
            echo "========================================"
            echo ""
            echo "Note: User configuration and data remain in home directories:"
            echo "  - Configuration: ~/.config/open-media-converter/"
            echo "  - Data and logs: ~/.local/share/open-media-converter/"
            echo ""
            echo "To completely remove all data, run:"
            echo "  rm -rf ~/.config/open-media-converter/"
            echo "  rm -rf ~/.local/share/open-media-converter/"
            echo ""
        else
            echo "Removing Open Media Converter..."
        fi

        # Update desktop database
        if command -v update-desktop-database >/dev/null 2>&1; then
            echo "Updating desktop database..."
            update-desktop-database -q /usr/share/applications || true
        fi

        # Update MIME database
        if command -v update-mime-database >/dev/null 2>&1; then
            echo "Updating MIME database..."
            update-mime-database /usr/share/mime || true
        fi

        # Update icon cache
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            echo "Updating icon cache..."
            gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
        fi

        if [ "$1" = "remove" ]; then
            echo ""
            echo "Open Media Converter has been removed successfully."
            echo "User configuration and data have been preserved."
            echo ""
        fi
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
