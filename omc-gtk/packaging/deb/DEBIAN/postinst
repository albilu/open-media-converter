#!/bin/bash
# postinst script for open-media-converter
# Post-installation script for Open Media Converter

set -e

# Summary of what this script does:
#  - Updates desktop database for .desktop file integration
#  - Updates MIME database for file type associations
#  - Updates icon cache for application icon
#  - Creates necessary user directories if needed
#  - Prints post-installation messages

case "$1" in
    configure)
        echo "Configuring Open Media Converter..."

        # Update desktop database for menu entry
        if command -v update-desktop-database >/dev/null 2>&1; then
            echo "Updating desktop database..."
            update-desktop-database -q /usr/share/applications || true
        fi

        # Update MIME database for file associations
        if command -v update-mime-database >/dev/null 2>&1; then
            echo "Updating MIME database..."
            update-mime-database /usr/share/mime || true
        fi

        # Update icon cache
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            echo "Updating icon cache..."
            gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
        fi

        # Set executable permissions on launcher script
        if [ -f /opt/open-media-converter/bin/open-media-converter ]; then
            chmod +x /opt/open-media-converter/bin/open-media-converter
        fi

        # Set executable permissions on embedded binaries if present
        if [ -d /opt/open-media-converter/lib/bin ]; then
            find /opt/open-media-converter/lib/bin -type f -name "ffmpeg" -exec chmod +x {} \; 2>/dev/null || true
            find /opt/open-media-converter/lib/bin -type f -name "pandoc" -exec chmod +x {} \; 2>/dev/null || true
        fi

        echo ""
        echo "╔════════════════════════════════════════════════════════════╗"
        echo "║  Open Media Converter has been successfully installed     ║"
        echo "╚════════════════════════════════════════════════════════════╝"
        echo ""
        echo "To launch the application:"
        echo "  • From application menu: Open Media Converter"
        echo "  • From terminal: open-media-converter"
        echo ""
        echo "All required dependencies have been installed:"
        echo "  ✓ Java (OpenJDK 17+)"
        echo "  ✓ GTK 4"
        echo "  ✓ FFmpeg (video/audio conversion)"
        echo "  ✓ ImageMagick (image conversion)"
        echo "  ✓ Pandoc (document conversion)"
        echo "  ✓ LibreOffice (office document conversion)"
        echo ""
        echo "Configuration: ~/.config/open-media-converter/"
        echo "Logs: ~/.local/share/open-media-converter/logs/"
        echo ""
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
